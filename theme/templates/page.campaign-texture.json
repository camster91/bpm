    "faq": {
      "type": "bpm-sites-pdp-faq",
      "settings": {
        "heading": "Frequently asked questions"
      },
      "blocks": {
        "0": {
          "type": "question",
          "settings": {
            "question": "Does it feel greasy?",
            "answer": "<p>No. BPM is designed to glide on smoothly and absorb cleanly without leaving a greasy finish.</p>"
          }
        },
        "1": {
          "type": "question",
          "settings": {
            "question": "How much should I use?",
            "answer": "<p>Start with a pea-sized amount for each underarm. Swipe it on and massage it. BPM is concentrated, so a little really does go a long way.</p>"
          }
        },
        "2": {
          "type": "question",
          "settings": {
            "question": "Is it baking-soda-free?",
            "answer": "<p>Yes. BPM is completely baking-soda-free. Its odour-control system uses magnesium hydroxide and zinc ricinoleate instead.</p>"
          }
        },
        "3": {
          "type": "question",
          "settings": {
            "question": "Is BPM an antiperspirant?",
            "answer": "<p>No. BPM is a deodorant, not an antiperspirant. It helps control odour but does not block perspiration, so your body can still sweat naturally.</p>"
          }
        },
        "4": {
          "type": "question",
          "settings": {
            "question": "Can I use it anywhere besides my underarms?",
            "answer": "<p>Yes. BPM can be used on external areas where odour control is needed. Do not use it on genitals or broken skin.</p>"
          }
        }
      },
