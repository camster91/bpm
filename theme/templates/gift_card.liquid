{% layout 'bpm-utility' %}
<section class="section wrap bpm-gift"><p class="eyebrow">{{ shop.name | escape }}</p><h1>{{ 'gift_card.heading' | t }}</h1>
<div class="bpm-gift-panel">
<p class="label">{{ 'gift_card.balance' | t }}</p><p class="bpm-gift-balance">{{ gift_card.balance | money_with_currency }}</p>
{% if gift_card.balance != gift_card.initial_value %}<p>{{ 'gift_card.original' | t }} {{ gift_card.initial_value | money_with_currency }}</p>{% endif %}
{% if gift_card.enabled == false %}<p role="status">{{ 'gift_card.disabled' | t }}</p>{% elsif gift_card.expired %}<p role="status">{{ 'gift_card.expired' | t }}</p>{% elsif gift_card.balance == 0 %}<p role="status">{{ 'gift_card.redeemed' | t }}</p>{% else %}<p>{{ 'gift_card.redeem' | t }}</p>{% endif %}
{% if gift_card.expires_on != blank %}<p>{{ 'gift_card.expires' | t }} <time datetime="{{ gift_card.expires_on | date: '%Y-%m-%d' }}">{{ gift_card.expires_on | date: '%Y-%m-%d' }}</time></p>{% endif %}
<p id="GiftCardCode" class="bpm-gift-code">{{ gift_card.code | format_code | escape }}</p>
{% if gift_card.enabled and gift_card.expired == false and gift_card.balance > 0 %}
{% if gift_card.qr_identifier != blank %}<div class="bpm-gift-qr" data-bpm-gift-qr="{{ gift_card.qr_identifier | escape }}" role="img" aria-label="{{ 'gift_card.qr' | t }}" hidden></div>{% endif %}
{% if gift_card.pass_url != blank %}<a class="button bpm-no-print" href="{{ gift_card.pass_url | escape }}">{{ 'gift_card.wallet' | t }}</a>{% endif %}
{% endif %}
<div class="bpm-gift-actions bpm-no-print"><button class="button" type="button" data-bpm-copy-code hidden>{{ 'gift_card.copy' | t }}</button><button class="button" type="button" data-bpm-print hidden>{{ 'gift_card.print' | t }}</button><a class="button dark" href="{{ routes.root_url }}">{{ 'products.shop' | t }}</a></div>
<p class="fine" role="status" data-bpm-copy-status data-success="{{ 'gift_card.copied' | t }}" data-failure="{{ 'gift_card.copy_failed' | t }}"></p>
</div></section>
<script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
<script src="{{ 'bpm-gift-card.js' | asset_url }}" defer></script>
