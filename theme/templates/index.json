      "settings": {
        "layout": "ownership",
        "eyebrow": "INDIGENOUS-OWNED",
        "heading": "A personal story.\nA real responsibility.",
        "body": "Founded by Corey Goss, a member of the Algonquins of Pikwàkanagàn First Nation. The mark connects family, identity and BPM’s musical roots.",
