    "beliefs": {
      "type": "bpm-sites-beliefs",
      "settings": {},
      "blocks": {
        "life": {
          "type": "statement",
          "settings": {
            "eyebrow": "ON BEAT. ON YOU.",
            "heading": "Made for\nreal life.",
            "body": "<p>For people who want deodorant to do its job.<br>No drama. No irritation. No nonsense.<br>Just a clean formula that goes on smoothly and works.</p>"
          }
        },
        "purpose": {
          "type": "statement",
          "settings": {
            "eyebrow": "NOTHING EXTRA.",
            "heading": "Why BPM\nexists.",
            "body": "<p>Most natural deodorants come with tradeoffs: <br>weak performance, irritation, plastic packaging, or inflated pricing. <br>BPM was built to do better. Reliable odour control, simple ingredients, smooth application, and a metal tube instead of the usual plastic stick, without inflated pricing.</p>"
          }
        }
      },
      "block_order": [
        "life",
        "purpose"
      ]
