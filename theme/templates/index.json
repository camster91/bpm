    "story": {
      "type": "bpm-sites-story",
      "settings": {
        "layout": "story",
        "eyebrow": "THE PEOPLE BEHIND THE PRODUCT",
        "heading": "Made with purpose.\nAnd a soundtrack.",
        "body": "Corey Goss started making deodorants in his kitchen in 2020. His standard: performance, skin feel, thoughtful packaging and fair pricing.",
        "image_alt": "BPM beside a turntable",
        "button_label": "Meet BPM",
        "page": "about-us"
      }
    },
    "ownership": {
      "type": "bpm-sites-story",
      "settings": {
        "layout": "ownership",
        "eyebrow": "INDIGENOUS-OWNED",
        "heading": "A personal story.\nA real responsibility.",
        "body": "Founded by Corey Goss, a member of the Algonquins of Pikw\u00e0kanag\u00e0n First Nation. The mark connects family, identity and BPM\u2019s musical roots.",
        "image_alt": "BPM\u2019s original owl and drum-inspired Indigenous-owned mark",
        "button_label": "The story behind the mark",
        "badge": "shopify://shop_images/CCIB_CIB-Member-PrimaryLogo_CIB-Lockup.png",
        "badge_alt": "Canadian Council for Indigenous Business member and Certified Indigenous Business logo supplied by BPM"
      }
    },
    "faq": {
      "type": "bpm-sites-questions",
      "settings": {
        "heading": "Frequently asked\nquestions."
      },
      "blocks": {
        "0": {
          "type": "question",
          "settings": {
            "question": "What makes BPM different from other deodorants?",
            "answer": "<p>BPM is a high performance natural deodorant in a recyclable metal tube. It is baking soda free, wax free, easy to apply, quick to absorb, and made to work without the usual compromises.</p>"
          }
        },
        "1": {
          "type": "question",
          "settings": {
            "question": "Does BPM actually work?",
            "answer": "<p>Yes. BPM was made to perform. It helps fight odour, goes on smoothly, and was refined using feedback from real people using it in everyday life.</p>"
          }
        },
        "2": {
          "type": "question",
          "settings": {
            "question": "How much should I apply?",
            "answer": "<p>A small amount is enough. Start with a pea sized amount for each underarm or area requiring protection, then adjust if needed.</p>"
          }
        },
        "3": {
          "type": "question",
          "settings": {
            "question": "How long does one 76g tube last?",
            "answer": "<p>It depends on how much you apply, but each tube contains over 300 pea-sized applications. That&#x27;s roughly 5 months of daily use. Start small. A little goes a long way.</p>"
          }
        },
        "4": {
          "type": "question",
          "settings": {
            "question": "Where can I use BPM?",
            "answer": "<p>Anywhere odour is a concern. That includes underarms, feet, chest, back, under skin folds, behind the knees, and an unpierced navel. Just keep it to external use and avoid extra sensitive areas.</p>"
          }
        }
      },
      "block_order": [
        "0",
        "1",
        "2",
        "3",
        "4"
      ]
    },
