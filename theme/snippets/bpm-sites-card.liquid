{% doc %}
Renders a native Shopify product using the Sites track-card layout.
@param {object} [images] - Native Files context
@param {boolean} [native_delivery] - False forces recovered SVG artwork
@param {product} product - Selected Shopify product
@param {image} [image] - Merchant photo override
@param {image} [image_2] - Second framed carton
@param {image} [image_3] - Third framed carton
@param {image} [image_4] - Fourth framed carton
@param {string} [source_pack] - Original Sites carton composition; merchant photo overrides take precedence
@param {string} [pack_label] - Verified pack description
@param {string} [display_title] - Optional presentation heading; native title remains the fallback
@param {string} [summary] - Merchant product summary
@param {string} [background] - Image panel colour
@param {string} button_label - Product link text
@param {string} [attributes] - Shopify editor attributes for a mapped product block
@example
{% render 'bpm-sites-card', product: block.settings.product, button_label: section.settings.product_label %}
{% enddoc %}
{% if product != blank %}
  {% assign card_title = display_title | default: product.title %}
  {% assign photo = image | default: product.featured_image %}
  {% assign pack_count = 1 %}{% if image_2 %}{% assign pack_count = pack_count | plus: 1 %}{% endif %}{% if image_3 %}{% assign pack_count = pack_count | plus: 1 %}{% endif %}{% if image_4 %}{% assign pack_count = pack_count | plus: 1 %}{% endif %}
  {% assign source_mixes = '1-0,0-1,2-0,0-2,1-1,4-0,0-4,2-2,3-1' | split: ',' %}
  {% assign use_source_pack = false %}{% if image == blank and image_2 == blank and image_3 == blank and image_4 == blank and source_mixes contains source_pack %}{% assign use_source_pack = true %}{% assign source_counts = source_pack | split: '-' %}{% assign pack_count = source_counts.first | plus: source_counts.last %}{% endif %}
  <article{% if use_source_pack %} data-pack="{{ pack_count }}"{% endif %} class="track-card" {{ attributes }}>
    <a class="track-image{% if use_source_pack %}{% if source_pack == '0-1' %} teal{% else %} olive{% endif %}{% endif %}" href="{{ product.url }}" style="{% if use_source_pack and pack_count == 1 %}--disc-color:{{ background | default: '#acb228' }}{% else %}background:{{ background | default: '#f3e4b7' }}{% endif %}" aria-label="{{ product.title | escape }}">
      {% if use_source_pack %}{% render 'bpm-sites-pack-art', mix: source_pack, images: images, native_delivery: native_delivery %}{% elsif photo != blank %}<div class="pack-line count-{{ pack_count }}">{{ photo | image_url: width: 1000 | image_tag: widths: '320,500,750,1000', sizes: '(max-width:760px) 40vw,20vw', loading: 'lazy', alt: product.title }}{% if image_2 %}{{ image_2 | image_url: width: 500 | image_tag: loading: 'lazy', alt: '' }}{% endif %}{% if image_3 %}{{ image_3 | image_url: width: 500 | image_tag: loading: 'lazy', alt: '' }}{% endif %}{% if image_4 %}{{ image_4 | image_url: width: 500 | image_tag: loading: 'lazy', alt: '' }}{% endif %}</div>{% endif %}
    </a>
    <div class="track-meta"><span>{{ pack_label | escape }}</span><span>{% if product.price_varies %}{% assign formatted_price = product.price | money_with_currency %}{{ 'products.price_from' | t: price: formatted_price }}{% else %}{{ product.price | money_with_currency }}{% endif %}</span></div>
    <h3><a href="{{ product.url }}">{{ card_title | escape }}</a></h3>
    {% if summary != blank %}<p>{{ summary | escape }}</p>{% endif %}
    {% unless product.available %}<p>{{ 'products.sold_out' | t }}</p>{% endunless %}
    <a class="track-link" href="{{ product.url }}">{{ button_label | escape }} <span aria-hidden="true">↗</span></a>
  </article>
{% endif %}
