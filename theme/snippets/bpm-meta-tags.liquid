{% doc %}
  Native page metadata and development indexing control.
  Uses Shopify page_image, including its native social sharing fallback.
  @example
  {% render 'bpm-meta-tags' %}
{% enddoc %}
{%- liquid
  assign private_page = false
  if request.page_type contains 'customers/' or request.page_type == 'gift_card' or request.page_type == 'password' or request.page_type == 'captcha'
    assign private_page = true
  endif
  assign noindex = false
  if settings.development_noindex != false or private_page or request.page_type == 'cart' or request.page_type == 'search' or request.page_type == '404'
    assign noindex = true
  endif
  assign social_type = 'website'
  if request.page_type == 'product'
    assign social_type = 'product'
  elsif request.page_type == 'article'
    assign social_type = 'article'
  endif
  assign social_image = ''
  if page_image != blank
    assign social_image = page_image | image_url: width: 1200
    assign image_prefix = social_image | slice: 0, 2
    assign image_first = social_image | slice: 0, 1
    if image_prefix == '//'
      assign social_image = social_image | prepend: 'https:'
    elsif image_first == '/'
      assign social_image = social_image | prepend: shop.url
    endif
  endif
-%}
<link rel="canonical" href="{{ canonical_url | escape }}">
<title>{{ page_title | escape }}{% if current_tags != blank %} — {{ current_tags | join: ', ' | escape }}{% endif %}{% if current_page > 1 %} — {{ current_page }}{% endif %}{% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title>
{% if noindex %}<meta name="robots" content="noindex,{% if private_page %}nofollow{% else %}follow{% endif %}">{% endif %}
{% unless private_page %}
  {% if page_description != blank %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:url" content="{{ canonical_url | escape }}">
  <meta property="og:site_name" content="{{ shop.name | escape }}">
  <meta property="og:type" content="{{ social_type }}">
  <meta name="twitter:title" content="{{ page_title | escape }}">
  {% if page_description != blank %}
    <meta property="og:description" content="{{ page_description | escape }}">
    <meta name="twitter:description" content="{{ page_description | escape }}">
  {% endif %}
  {% if social_image != blank %}
    <meta property="og:image" content="{{ social_image | escape }}">
    <meta name="twitter:image" content="{{ social_image | escape }}">
    <meta name="twitter:card" content="summary_large_image">
    {% if page_image.alt != blank %}
      <meta property="og:image:alt" content="{{ page_image.alt | escape }}">
      <meta name="twitter:image:alt" content="{{ page_image.alt | escape }}">
    {% endif %}
  {% else %}
    <meta name="twitter:card" content="summary">
  {% endif %}
{% endunless %}
