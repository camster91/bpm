{% doc %}
Renders configured Shopify market and language choices with native POST and no JavaScript requirement.
@param {string} id - Unique form and field ID prefix
@param {object} localization - Native available and current store markets and languages
{% enddoc %}
{% if localization.available_countries.size > 1 or localization.available_languages.size > 1 %}
{% form 'localization', id: id, class: 'bpm-localization' %}
{% if localization.available_countries.size > 1 %}<div><label for="{{ id }}-country">{{ 'localization.country' | t }}</label><select id="{{ id }}-country" name="country_code">{% for country in localization.available_countries %}<option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>{{ country.name | escape }} ({{ country.currency.iso_code | escape }})</option>{% endfor %}</select></div>{% endif %}
{% if localization.available_languages.size > 1 %}<div><label for="{{ id }}-language">{{ 'localization.language' | t }}</label><select id="{{ id }}-language" name="language_code">{% for language in localization.available_languages %}<option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %} lang="{{ language.iso_code }}">{{ language.endonym_name | escape }}</option>{% endfor %}</select></div>{% endif %}
<button class="button" type="submit">{{ 'localization.apply' | t }}</button>{% endform %}{% endif %}
