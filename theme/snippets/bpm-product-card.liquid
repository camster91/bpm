{% doc %}
  Renders a real Shopify product with native price, availability and destination.
  @param {product} product - Selected product
  @param {image} [image] - Optional merchant-selected product photograph
  @param {string} [image_treatment] - Figma crop or full photograph
  @param {string} [label] - Optional display name
  @param {string} [button_label] - Optional action label
  @param {string} [background] - Card background
  @param {string} [text_color] - Card foreground
{% enddoc %}
{% if product != blank %}
  {% assign card_image = image | default: product.featured_image %}
  <article class="bpm-product-card" style="--card-bg: {{ background | default: '#228782' }}; --card-ink: {{ text_color | default: '#ffffff' }};">
    <a class="bpm-product-card__image" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
      <div class="bpm-product-card__media{% if image_treatment == 'figma' %} bpm-product-card__media--figma{% endif %}">
      {% if card_image != blank %}{{ card_image | image_url: width: 1200 | image_tag: widths: '320, 480, 640, 960, 1200', sizes: '(min-width: 750px) 45vw, 90vw', loading: 'lazy', alt: product.title }}{% else %}{{ 'product-1' | placeholder_svg_tag: 'bpm-product-card__placeholder' }}{% endif %}
      </div>
    </a>
    <div class="bpm-product-card__details">
      <h3><a href="{{ product.url }}">{{ label | default: product.title | escape }}</a></h3>
      <p class="bpm-product-card__price">{% if product.price_varies %}{% assign formatted_price = product.price | money %}{{ 'products.price_from' | t: price: formatted_price }}{% else %}{{ product.price | money }}{% endif %}</p>
      {% unless product.available %}<p class="bpm-product-card__status">{{ 'products.sold_out' | t }}</p>{% endunless %}
      <a class="bpm-button" href="{{ product.url }}">{{ button_label | default: product.title | escape }}<img src="{{ 'bpm-arrow.svg' | asset_url }}" width="24" height="24" alt=""></a>
    </div>
  </article>
{% endif %}
