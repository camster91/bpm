{% if section.settings.text != blank %}
  <div class="bpm-announcement" data-bpm-announcement style="--announcement-bg: {{ section.settings.background }}; --announcement-color: {{ section.settings.text_color }}; --announcement-size: {{ section.settings.text_size }}px; --announcement-height: {{ section.settings.height }}px;">
    {% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{% endif %}
    {{ section.settings.text | escape }}
    {% if section.settings.link != blank %}</a>{% endif %}
  </div>
{% endif %}
{% schema %}
{
  "name": "BPM announcement",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "paragraph", "content": "Changes affect the whole store. Confirm shipping or offer wording before publication. Empty text hides the bar." },
    { "type": "text", "id": "text", "label": "Announcement text" },
    { "type": "url", "id": "link", "label": "Optional destination" },
    { "type": "color", "id": "background", "label": "Background", "default": "#f157b7" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#fff9b3" },
    { "type": "range", "id": "text_size", "label": "Desktop text size", "min": 14, "max": 28, "step": 1, "default": 23, "unit": "px" },
    { "type": "range", "id": "height", "label": "Minimum height", "min": 32, "max": 80, "step": 2, "default": 52, "unit": "px" }
  ],
  "presets": [{ "name": "BPM announcement" }]
}
{% endschema %}
