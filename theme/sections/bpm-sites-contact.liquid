<section class="section wrap"><div class="split"><div class="contact-routes"><h3>{{ section.settings.heading | escape }}</h3>{% if section.settings.email != blank %}<a href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }} ↗</a>{% endif %}<p>{{ section.settings.response | escape }}</p><hr><div class="prose">{{ section.settings.instructions }}</div>{% if shop.privacy_policy.url != blank %}<p class="fine"><a href="{{ shop.privacy_policy.url }}">{{ 'general.privacy' | t }}</a></p>{% endif %}</div><div class="contact-form">{% assign form_id = 'Contact-' | append: section.id %}{% form 'contact', id: form_id, class: 'preview-form bpm-contact-form' %}
{% if form.posted_successfully? %}<p role="status" tabindex="-1">{{ 'contact.success' | t }}</p>{% else %}{% if form.errors %}<div id="{{ form_id }}-errors" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
<div class="form-pair"><div><label for="{{ form_id }}-name">{{ 'contact.name' | t }}</label><input id="{{ form_id }}-name" name="contact[name]" required autocomplete="name" value="{{ form.name | default: customer.name | escape }}"></div><div><label for="{{ form_id }}-email">{{ 'contact.email' | t }}</label><input id="{{ form_id }}-email" name="contact[email]" type="email" required autocomplete="email" autocapitalize="off" value="{{ form.email | default: customer.email | escape }}"{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="{{ form_id }}-errors"{% endif %}></div></div>
<label for="{{ form_id }}-topic">{{ 'contact.topic' | t }}</label><select id="{{ form_id }}-topic" name="contact[topic]">{% for block in section.blocks %}{% if block.settings.topic != blank %}<option{% if form.topic == block.settings.topic %} selected{% endif %}>{{ block.settings.topic | escape }}</option>{% endif %}{% endfor %}</select>
<label for="{{ form_id }}-body">{{ 'contact.message' | t }}</label><textarea id="{{ form_id }}-body" name="contact[body]" required rows="6">{{ form.body | escape }}</textarea><button class="button dark" type="submit">{{ 'contact.submit' | t }}<span aria-hidden="true">→</span></button>{% endif %}{% endform %}</div></div></section>
{% schema %}
{"name": "Bpm Contact form", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Send us a note."}, {"type": "text", "id": "email", "label": "Verified contact email"}, {"type": "text", "id": "response", "label": "Approved response expectation"}, {"type": "richtext", "id": "instructions", "label": "Contact instructions"}], "blocks": [{"type": "topic", "name": "Topic", "settings": [{"type": "text", "id": "topic", "label": "Topic"}]}], "max_blocks": 12, "presets": [{"name": "Bpm Contact form"}]}
{% endschema %}
