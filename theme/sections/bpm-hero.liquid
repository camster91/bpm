{% liquid
  assign destination = section.settings.collection.url | default: section.settings.button_url | default: routes.all_products_collection_url
  assign image_loading = 'eager'
  if section.index > 1
    assign image_loading = 'lazy'
  endif
%}
<section class="bpm-hero" style="--hero-bg: {{ section.settings.background }}; --hero-ink: {{ section.settings.text_color }}; --hero-accent: {{ section.settings.accent_color }}; --hero-height: {{ section.settings.height }}px;">
  <div class="bpm-hero__photograph{% if section.settings.image != blank %} bpm-hero__photograph--custom{% endif %}">
    {% if section.settings.image != blank %}
      {% unless section.index > 1 %}
        {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '480, 800, 1200, 1600, 2000, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', preload: true, alt: section.settings.image_alt }}
      {% else %}
        {{ section.settings.image | image_url: width: 2400 | image_tag: widths: '480, 800, 1200, 1600, 2000, 2400', sizes: '100vw', loading: 'lazy', alt: section.settings.image_alt }}
      {% endunless %}
    {% else %}
      <img src="{{ 'bpm-home-photo.png' | asset_url }}" width="1387" height="1024" alt="{{ section.settings.image_alt | escape }}" loading="{{ image_loading }}"{% unless section.index > 1 %} fetchpriority="high"{% endunless %}>
    {% endif %}
  </div>
  <div class="bpm-hero__gradient"></div>
  <div class="bpm-container bpm-hero__content">
    <h1>
      <span>{{ section.settings.heading | escape }}</span>
      {% if section.settings.accent_heading != blank %}<span class="bpm-hero__accent"><img src="{{ 'bpm-hero-highlight.svg' | asset_url }}" width="543" height="79" alt="">{{ section.settings.accent_heading | escape }}</span>{% endif %}
      {% if section.settings.final_heading != blank %}<span>{{ section.settings.final_heading | escape }}</span>{% endif %}
    </h1>
    {% if section.settings.body != blank %}<div class="bpm-hero__body">{{ section.settings.body }}</div>{% endif %}
    {% if section.settings.button_label != blank %}<a class="bpm-button" href="{{ destination }}">{{ section.settings.button_label | escape }}<img src="{{ 'bpm-arrow-ink.svg' | asset_url }}" width="24" height="24" alt=""></a>{% endif %}
  </div>
</section>
{% stylesheet %}
.bpm-hero{position:relative;min-height:var(--hero-height);background:var(--hero-bg);color:var(--hero-ink);overflow:hidden;isolation:isolate}
.bpm-hero__photograph{position:absolute;inset:-42px 0 0;height:calc(100% + 42px);overflow:hidden;z-index:-2}
.bpm-hero__photograph>img{position:absolute;width:93.19%;max-width:none;height:105.51%;left:17.13%;top:3.62%;object-fit:fill}
.bpm-hero__photograph--custom{inset:0;height:100%}
.bpm-hero__photograph--custom>img{inset:0;width:100%;height:100%;object-fit:cover}
.bpm-hero__gradient{position:absolute;inset:0;z-index:-1;background:linear-gradient(-87.549deg,transparent 69.142%,var(--hero-bg) 80.073%)}
.bpm-hero__content{padding-top:225px;padding-bottom:100px}
.bpm-hero h1{max-width:740px;font-size:64px;line-height:1.37;text-transform:uppercase;overflow-wrap:anywhere}
.bpm-hero h1>span{display:block}
.bpm-hero__accent{position:relative;isolation:isolate;width:max-content;max-width:100%;color:var(--hero-accent)}
.bpm-hero__accent>img{position:absolute;z-index:-1;left:-8px;top:7.32px;max-width:none}
.bpm-hero__body{max-width:476px;font-size:20px;line-height:1.5;margin-top:13px;margin-bottom:28px}
.bpm-hero__body p+p{margin-top:1em}
.bpm-hero__content>.bpm-button{margin-top:32px;padding-inline:12px}
.bpm-hero__body+.bpm-button{margin-top:0}
@media(min-width:1101px){.bpm-header--overlay .bpm-header__logo{transform:translateX(60px)}}
@media(max-width:1100px){.bpm-hero__content{padding-top:172px}.bpm-hero h1{font-size:48px;max-width:580px}.bpm-hero__accent>img{top:6px;transform:scale(.75);transform-origin:top left}.bpm-hero__photograph>img{left:0;width:120%;height:100%;top:0;object-fit:cover}}
@media(max-width:640px){.bpm-header--overlay{color:var(--bpm-ink)}.bpm-hero{min-height:880px}.bpm-hero__content{padding-top:130px;padding-bottom:380px}.bpm-hero h1{font-size:32px;max-width:100%}.bpm-hero__accent>img{top:4px;transform:scale(.5);transform-origin:top left}.bpm-hero__body{font-size:18px;max-width:100%;margin-top:20px;margin-bottom:24px}.bpm-hero__photograph{inset:380px 0 0;height:calc(100% - 380px)}.bpm-hero__photograph>img{left:-14%;width:120%;height:100%;object-fit:cover;object-position:70% 50%}.bpm-hero__gradient{background:linear-gradient(180deg,var(--hero-bg) 40%,transparent 60%)}}
{% endstylesheet %}
{% schema %}
{
  "name": "BPM photo hero",
  "settings": [
    { "type": "paragraph", "content": "Use approved copy. The original Figma photograph is used when no override is selected." },
    { "type": "text", "id": "heading", "label": "Heading, first line", "default": "BPM" },
    { "type": "text", "id": "accent_heading", "label": "Highlighted heading", "default": "Deodorant" },
    { "type": "text", "id": "final_heading", "label": "Heading, final line" },
    { "type": "richtext", "id": "body", "label": "Approved description" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop deodorants" },
    { "type": "collection", "id": "collection", "label": "Button collection" },
    { "type": "url", "id": "button_url", "label": "Alternative button link", "info": "Used when no collection is selected." },
    { "type": "image_picker", "id": "image", "label": "Photo override" },
    { "type": "text", "id": "image_alt", "label": "Photo description", "default": "Person holding a BPM deodorant tube" },
    { "type": "range", "id": "height", "min": 597, "max": 1097, "step": 5, "default": 897, "unit": "px", "label": "Desktop minimum height" },
    { "type": "color", "id": "background", "label": "Background", "default": "#fdb16c" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#231f20" },
    { "type": "color", "id": "accent_color", "label": "Highlight text", "default": "#d36b02" }
  ],
  "presets": [{ "name": "BPM photo hero" }]
}
{% endschema %}
