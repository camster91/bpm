<section class="section wrap"><div class="section-heading"><div class="intro-copy">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape | newline_to_br }}</h2>{% endif %}{% if section.settings.body != blank %}<p class="lead">{{ section.settings.body | escape }}</p>{% endif %}</div>{% if section.settings.blog != blank and section.settings.button_label != blank %}<a class="button" href="{{ section.settings.blog.url }}">{{ section.settings.button_label | escape }}<span aria-hidden="true">→</span></a>{% endif %}</div>
<div class="editorial-grid">{% for block in section.blocks %}{% assign story = block.settings.article %}{% if story != blank %}<article class="editorial-card" {{ block.shopify_attributes }}><a href="{{ story.url }}">
{% assign photo = block.settings.image | default: story.image %}{% assign source_art = block.settings.source_art | default: 'none' %}
{% if photo != blank or source_art != 'none' %}<div class="editorial-image{% if source_art == 'ownership' %} mark-image{% endif %}">
{% if block.settings.image != blank %}{{ block.settings.image | image_url: width: 1000 | image_tag: widths: '320,600,1000', sizes: '(max-width:760px) 90vw,30vw', loading: 'lazy', alt: block.settings.image.alt }}
{% elsif source_art != 'none' %}{% case source_art %}{% when 'texture' %}<img src="{{ 'bpm-sites-texture.jpg' | asset_url }}" width="1254" height="1254" alt="" loading="lazy">{% when 'ownership' %}<img src="{{ 'bpm-sites-ownership.png' | asset_url }}" width="864" height="847" alt="" loading="lazy">{% when 'story' %}<img src="{{ 'bpm-sites-story.jpg' | asset_url }}" width="1600" height="2844" alt="" loading="lazy">{% endcase %}
{% elsif photo != blank %}{{ photo | image_url: width: 1000 | image_tag: widths: '320,600,1000', sizes: '(max-width:760px) 90vw,30vw', loading: 'lazy', alt: photo.alt }}{% endif %}</div>{% endif %}
<p class="eyebrow">{{ story.published_at | date: '%Y-%m-%d' }}{% if section.settings.blog != blank %} / {{ section.settings.blog.title | escape }}{% endif %}</p><h3>{{ story.title | escape }}</h3>{% if section.settings.article_label != blank %}<span class="track-link">{{ section.settings.article_label | escape }} <span aria-hidden="true">↗</span></span>{% endif %}</a></article>{% endif %}{% endfor %}</div></section>
{% schema %}
{
  "name": "BPM Sites journal cards",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE BREAKDOWN"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "A little more\nbehind the beat."
    },
    {
      "type": "text",
      "id": "body",
      "label": "Copy"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog destination"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Blog link label",
      "default": "Read The Breakdown"
    },
    {
      "type": "text",
      "id": "article_label",
      "label": "Article link label",
      "default": "Read the story"
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Article card",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "select",
          "id": "source_art",
          "label": "Original Sites editorial treatment",
          "options": [
            {
              "value": "none",
              "label": "Article image"
            },
            {
              "value": "texture",
              "label": "Cream texture"
            },
            {
              "value": "ownership",
              "label": "Ownership mark"
            },
            {
              "value": "story",
              "label": "Turntable packaging photo"
            }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "BPM Sites journal cards",
      "blocks": [
        {
          "type": "article"
        },
        {
          "type": "article"
        },
        {
          "type": "article"
        }
      ]
    }
  ]
}
{% endschema %}
