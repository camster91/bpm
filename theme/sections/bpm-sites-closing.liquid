<section class="closing"><div class="wrap closing-inner">{% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape | newline_to_br }}</h2>{% endif %}{% if section.settings.button_label != blank %}{% assign destination = section.settings.collection.url | default: routes.all_products_collection_url %}<a class="button" href="{{ destination }}">{{ section.settings.button_label | escape }}<span aria-hidden="true">→</span></a>{% endif %}</div></section>
{% schema %}
{
  "name": "Bpm Closing",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Find your\neveryday BPM."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Collection link",
      "default": "Shop all tracks"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Destination"
    }
  ],
  "presets": [
    {
      "name": "Bpm Closing"
    }
  ]
}
{% endschema %}
