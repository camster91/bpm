<section class="section ink-band"><div class="wrap split"><div><div class="intro-copy">{% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}{% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape | newline_to_br }}</h2>{% endif %}{% if section.settings.body != blank %}<p class="lead">{{ section.settings.body | escape }}</p>{% endif %}</div>{% if section.settings.product != blank and section.settings.button_label != blank %}<a class="button" href="{{ section.settings.product.url }}#formula">{{ section.settings.button_label | escape }}<span aria-hidden="true">→</span></a>{% endif %}</div><div class="ingredient-list">{% for block in section.blocks %}{% if block.settings.heading != blank %}<p {{ block.shopify_attributes }}><span>{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span> {{ block.settings.heading | escape }}{% if block.settings.role != blank %}<small>{{ block.settings.role | escape }}</small>{% endif %}</p>{% endif %}{% endfor %}{% if section.settings.note != blank %}<p class="fine">{{ section.settings.note | escape }}</p>{% endif %}</div></div></section>
{% schema %}
{
  "name": "Bpm Formula",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "POTION MATTERS"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Every ingredient\nhas a job."
    },
    {
      "type": "text",
      "id": "body",
      "label": "Copy",
      "default": "Odour control. Moisture absorption. A smooth glide. Nothing added just to fill the tube."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Product link label",
      "default": "Meet the formula"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Linked product"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Formula note"
    }
  ],
  "presets": [
    {
      "name": "Bpm Formula"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient role",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Ingredient name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role"
        }
      ]
    }
  ],
  "max_blocks": 24
}
{% endschema %}
