{% assign inside = product.metafields.custom.whats_inside_description %}
{% assign shipping_notes = product.metafields.custom.shipping.value %}
{% if product.description != blank or inside.value != blank or shipping_notes != blank %}<section class="section wrap"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape | newline_to_br }}</h2>
  {% if product.description != blank %}<div class="prose bpm-product-description">{{ product.description }}</div>{% endif %}
  {% if inside.value != blank %}<div class="prose bpm-product-details"><h3>{% if product.metafields.custom.whats_inside_title.value != blank %}{{ product.metafields.custom.whats_inside_title.value | escape }}{% else %}{{ 'products.whats_inside' | t }}{% endif %}</h3>{% comment %}Shopify rich-text headings are emitted as plain tags. Scope this correction to ingredient notes below the section H2 and notes H3; preserve the shared metafield and all other HTML.{% endcomment %}{{ inside | metafield_tag | replace: '<h1>', '<h4>' | replace: '</h1>', '</h4>' }}</div>{% endif %}
  {% if shipping_notes != blank %}<div class="prose bpm-product-details"><h3>{% if product.metafields.custom.shipping_title.value != blank %}{{ product.metafields.custom.shipping_title.value | escape }}{% else %}{{ 'products.shipping_notes' | t }}{% endif %}</h3><p>{{ shipping_notes | escape | newline_to_br }}</p>{% if shop.shipping_policy.url != blank %}<p><a href="{{ shop.shipping_policy.url }}">{{ 'products.shipping_policy' | t }}</a></p>{% endif %}</div>{% endif %}
</section>{% endif %}
{% schema %}
{"name":"Bpm Full product notes","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE FULL PRODUCT NOTES"},{"type":"textarea","id":"heading","label":"Heading","default":"The details,\nin full."}],"presets":[{"name":"Bpm Full product notes"}]}
{% endschema %}
