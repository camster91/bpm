<section class="section wrap bpm-not-found"><p class="eyebrow">404</p><h1>{{ 'not_found.heading' | t }}</h1><p class="lead">{{ 'not_found.body' | t }}</p><a class="button" href="{{ routes.all_products_collection_url }}">{{ 'not_found.shop' | t }} <span aria-hidden="true">→</span></a><form class="bpm-recovery-search" action="{{ routes.search_url }}" method="get" role="search"><label for="Recovery-{{ section.id }}">{{ 'not_found.search' | t }}</label><div><input id="Recovery-{{ section.id }}" name="q" type="search" required><button class="button dark" type="submit">{{ 'general.search' | t }}</button></div></form></section>
{% schema %}
{"name":"Bpm Page not found","settings":[]}
{% endschema %}
