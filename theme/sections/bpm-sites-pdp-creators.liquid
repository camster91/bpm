{% capture stories %}{% for block in section.blocks %}{% if block.settings.approved and block.settings.title != blank and block.settings.creator != blank and block.settings.transcript != blank %}{% assign native_video = block.settings.video %}{% if native_video != blank or block.settings.original_url != blank %}<article class="creator-slot" {{ block.shopify_attributes }}>
{% if native_video != blank %}{% if block.settings.captions != blank %}<video controls playsinline preload="none" aria-label="{{ block.settings.title | escape }}" {% if native_video.preview_image != blank %}poster="{{ native_video.preview_image | image_url: width: 800 }}"{% endif %}>{% for source in native_video.sources %}<source src="{{ source.url }}" type="{{ source.mime_type }}">{% endfor %}<track kind="captions" src="{{ block.settings.captions }}" srclang="{{ block.settings.caption_language | escape }}" label="{{ block.settings.caption_label | escape }}" default></video>{% else %}{{ native_video | video_tag: controls: true, playsinline: true, preload: 'none', autoplay: false }}{% endif %}{% elsif block.settings.poster != blank %}{{ block.settings.poster | image_url: width: 800 | image_tag: widths: '320,500,800', sizes: '(max-width:680px) 85vw,28vw', loading: 'lazy', alt: block.settings.title }}{% endif %}
<h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.creator | escape }}</p>{% if block.settings.disclosure != blank %}<p class="fine">{{ block.settings.disclosure | escape }}</p>{% endif %}{% if block.settings.original_url != blank %}<a href="{{ block.settings.original_url }}">{{ 'products.creator_original' | t }} <span aria-hidden="true">↗</span></a>{% endif %}<details><summary><strong>{{ 'products.creator_transcript' | t }}</strong><span aria-hidden="true">+</span></summary><div class="prose">{{ block.settings.transcript }}</div></details>
</article>{% endif %}{% endif %}{% endfor %}{% endcapture %}{% assign stories = stories | strip %}
{% if stories != blank %}{{ 'bpm-pdp.css' | asset_url | stylesheet_tag }}<section class="bpm-pdp creator-stories wrap" id="creator-stories-{{ section.id }}"><div class="section-intro"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape | newline_to_br }}</h2><p>{{ section.settings.intro | escape }}</p></div><div class="creator-grid">{{ stories }}</div></section>{% endif %}
{% schema %}
{"name": "Bpm Creator stories", "settings": [{"type": "paragraph", "content": "Use only approved creator media with permission, accurate attribution, required sponsorship disclosure and captions. Native videos need uploaded caption VTT or approved burned-in captions. External posts load only when their link is followed."}, {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "BPM IN THE WILD"}, {"type": "textarea", "id": "heading", "label": "Heading", "default": "Your tube.\nYour take."}, {"type": "textarea", "id": "intro", "label": "Introduction", "default": "Everyday routines, first impressions and the people who put BPM to use."}], "blocks": [{"type": "story", "name": "Approved creator story", "settings": [{"type": "checkbox", "id": "approved", "label": "Media rights and captions verified", "default": false}, {"type": "text", "id": "title", "label": "Story title"}, {"type": "text", "id": "creator", "label": "Creator attribution"}, {"type": "text", "id": "disclosure", "label": "Sponsorship / material connection"}, {"type": "video", "id": "video", "label": "Shopify-hosted captioned video"}, {"type": "url", "id": "captions", "label": "Uploaded caption VTT URL"}, {"type": "text", "id": "caption_language", "label": "Caption language code", "default": "en"}, {"type": "text", "id": "caption_label", "label": "Caption language label", "default": "English"}, {"type": "image_picker", "id": "poster", "label": "External post poster"}, {"type": "url", "id": "original_url", "label": "Original creator post"}, {"type": "richtext", "id": "transcript", "label": "Accessible transcript and visual description"}]}], "max_blocks": 3, "presets": [{"name": "Bpm Creator stories"}]}
{% endschema %}
