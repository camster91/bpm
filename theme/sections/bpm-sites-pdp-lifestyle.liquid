{{ 'bpm-pdp.css' | asset_url | stylesheet_tag }}
<section class="bpm-pdp lifestyle"><div class="wrap lifestyle-grid"><div class="lifestyle-photo">{% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 1600 | image_tag: widths: '500,800,1200,1600', sizes: '(max-width:680px) 90vw,45vw', loading: 'lazy', alt: section.settings.image_alt }}{% else %}<img src="{{ 'bpm-sites-turntable.jpg' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="1600" height="2844" loading="lazy">{% endif %}</div><div><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape | newline_to_br }}</h2><p class="lead">{{ section.settings.intro | escape }}</p><p>{{ section.settings.body | escape }}</p>{% if section.settings.page != blank and section.settings.button_label != blank %}<a class="button" href="{{ section.settings.page.url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>{% endif %}<p class="signature">{{ section.settings.signature | escape }}</p></div></div></section>
{% schema %}
{"name": "Bpm Product soundtrack", "settings": [{"type": "image_picker", "id": "image", "label": "Original photo override"}, {"type": "text", "id": "image_alt", "label": "Image description", "default": "BPM tube beside a turntable"}, {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "ON BEAT. ON YOU."}, {"type": "textarea", "id": "heading", "label": "Heading", "default": "A daily essential.\nWith a soundtrack."}, {"type": "textarea", "id": "intro", "label": "Introduction", "default": "Music is part of BPM’s character, from the founder’s working soundtrack to the names in your rotation."}, {"type": "textarea", "id": "body", "label": "Approved story", "default": "Corey Goss started making deodorant in his kitchen in 2020. Performance, ingredients, packaging and fair pricing became the standard behind the product."}, {"type": "page", "id": "page", "label": "About page"}, {"type": "text", "id": "button_label", "label": "Page link", "default": "Meet BPM"}, {"type": "text", "id": "signature", "label": "Approved signature", "default": "Indigenous-owned. Toronto-built. Made to perform."}], "presets": [{"name": "Bpm Product soundtrack"}]}
{% endschema %}
