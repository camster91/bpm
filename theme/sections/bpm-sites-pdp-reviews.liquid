{% capture review_content %}{% render 'bpm-app-blocks', blocks: section.blocks %}{% endcapture %}{% assign review_content = review_content | strip %}
{% if review_content != blank %}{{ 'bpm-pdp.css' | asset_url | stylesheet_tag }}<section class="bpm-pdp feedback" id="feedback-{{ section.id }}"><div class="wrap"><div class="section-intro"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape | newline_to_br }}</h2><p>{{ section.settings.intro | escape }}</p></div>
<div class="customer-review-layout"><div class="review-system-slot">{{ review_content }}</div>{% if section.settings.featured_approved and section.settings.quote != blank and section.settings.author != blank and section.settings.source != blank %}<figure class="customer-quote"><p class="eyebrow">{{ section.settings.quote_label | escape }}</p><blockquote>{{ section.settings.quote | escape }}</blockquote><figcaption>{{ section.settings.author | escape }}<br><a href="{{ section.settings.source }}">{{ 'products.review_source' | t }}</a></figcaption></figure>{% endif %}</div></div></section>{% endif %}
{% schema %}
{"name": "Bpm Product reviews", "settings": [{"type": "paragraph", "content": "Select the installed product review app block. Live reviews remain supplied by the app. Only feature an authentic review with verified attribution and source."}, {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FROM YOUR SIDE OF THE BEAT"}, {"type": "textarea", "id": "heading", "label": "Heading", "default": "Real routines.\nReal feedback."}, {"type": "textarea", "id": "intro", "label": "Introduction", "default": "What people say about their everyday BPM."}, {"type": "checkbox", "id": "featured_approved", "label": "Featured review verified for this product", "default": false}, {"type": "text", "id": "quote_label", "label": "Featured label", "default": "A CUSTOMER’S TAKE"}, {"type": "textarea", "id": "quote", "label": "Verified review quote"}, {"type": "text", "id": "author", "label": "Verified attribution"}, {"type": "url", "id": "source", "label": "Original review source"}], "blocks": [{"type": "@app"}], "presets": [{"name": "Bpm Product reviews"}]}
{% endschema %}
