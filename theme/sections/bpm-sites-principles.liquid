<section class="section{% if section.settings.band %} butter-band{% else %} wrap{% endif %}"><div{% if section.settings.band %} class="wrap"{% endif %}><div class="intro-copy"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape | newline_to_br }}</h2></div><div class="{% if section.settings.layout == 'list' %}value-list{% else %}principle-grid{% endif %}">{% for block in section.blocks %}{% if block.settings.heading != blank %}<article {{ block.shopify_attributes }}><span class="eyebrow">{{ forloop.index | prepend: '0' }}</span><h3>{{ block.settings.heading | escape }}</h3><p>{{ block.settings.body | escape }}</p></article>{% endif %}{% endfor %}</div></div></section>
{% schema %}
{"name": "Bpm Principles", "settings": [{"type": "text", "id": "eyebrow", "label": "Eyebrow"}, {"type": "textarea", "id": "heading", "label": "Heading"}, {"type": "select", "id": "layout", "label": "Layout", "options": [{"value": "grid", "label": "Four pillars"}, {"value": "list", "label": "Numbered value rows"}], "default": "grid"}, {"type": "checkbox", "id": "band", "label": "Butter background", "default": false}], "blocks": [{"type": "principle", "name": "Principle", "settings": [{"type": "text", "id": "heading", "label": "Heading"}, {"type": "textarea", "id": "body", "label": "Approved copy"}]}], "max_blocks": 12, "presets": [{"name": "Bpm Principles"}]}
{% endschema %}
