{{ 'bpm-pdp.css' | asset_url | stylesheet_tag }}
<section class="bpm-pdp faq wrap" id="faq-{{ section.id }}"><div class="section-intro"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2></div>
<div>{% for block in section.blocks %}{% if block.settings.question != blank and block.settings.answer != blank %}<details {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}<span aria-hidden="true">+</span></summary><div class="bpm-pdp-answer">{{ block.settings.answer }}</div></details>{% endif %}{% endfor %}
{% if shop.shipping_policy.url != blank %}<details><summary>{{ 'products.shipping_question' | t }}<span aria-hidden="true">+</span></summary><p><a href="{{ shop.shipping_policy.url }}">{{ 'products.shipping_policy' | t }}</a></p></details>{% endif %}</div></section>
{% schema %}
{"name": "Bpm Product questions", "settings": [{"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A FEW THINGS YOU MIGHT BE WONDERING"}, {"type": "text", "id": "heading", "label": "Heading", "default": "Good questions."}], "blocks": [{"type": "question", "name": "Question", "settings": [{"type": "text", "id": "question", "label": "Question"}, {"type": "richtext", "id": "answer", "label": "Approved answer"}]}], "max_blocks": 24, "presets": [{"name": "Bpm Product questions"}]}
{% endschema %}
