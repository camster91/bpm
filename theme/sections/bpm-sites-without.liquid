{% if section.settings.heading != blank and section.blocks.size > 0 %}<section class="section bpm-without"><div class="wrap"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><ul class="bpm-without-list">{% for block in section.blocks %}{% if block.settings.label != blank %}<li {{ block.shopify_attributes }}><span aria-hidden="true">✦</span>{{ block.settings.label | escape }}</li>{% endif %}{% endfor %}</ul></div></section>{% endif %}
{% schema %}
{
  "name": "BPM formulated without",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Excluded ingredient",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Ingredient name"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "BPM formulated without"
    }
  ]
}
{% endschema %}
