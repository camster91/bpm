<section class="section wrap bpm-access"><div>
<p class="eyebrow">{{ shop.name | escape }}</p><h1>{% if section.settings.heading != blank %}{{ section.settings.heading | escape | newline_to_br }}{% else %}{{ 'password.heading' | t }}{% endif %}</h1>
{% if shop.password_message != blank %}<div class="prose">{{ shop.password_message }}</div>{% endif %}
{% if section.settings.intro != blank %}<p class="lead">{{ section.settings.intro | escape }}</p>{% endif %}
</div><div class="bpm-access-panel">
{% assign form_id = 'StoreAccess-' | append: section.id %}
{% form 'storefront_password', id: form_id %}
{% if form.errors %}<div id="{{ form_id }}-errors" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
<label for="{{ form_id }}-password">{{ 'password.label' | t }}</label>
<input id="{{ form_id }}-password" name="password" type="password" required autocomplete="current-password"{% if form.errors %} aria-invalid="true" aria-describedby="{{ form_id }}-errors"{% endif %}>
<button class="button dark" type="submit">{{ 'password.enter' | t }} <span aria-hidden="true">→</span></button>
{% endform %}
</div></section>
{% schema %}
{"name":"Bpm Store access","settings":[{"type":"textarea","id":"heading","label":"Heading override"},{"type":"textarea","id":"intro","label":"Additional message"}]}
{% endschema %}
