{% assign columns = 2 %}{% if section.settings.columns == '5' %}{% assign columns = 5 %}{% endif %}
{% assign rows = 0 %}{% for block in section.blocks %}{% if block.settings.cell_1 != blank %}{% assign rows = rows | plus: 1 %}{% endif %}{% endfor %}{% if rows > 0 %}
<section class="section wrap bpm-table-section"><h2 id="TableHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
{% if columns > 2 %}<p class="fine">{{ 'general.table_scroll' | t }}</p>{% endif %}
<div class="bpm-data-table-wrap" role="region" aria-labelledby="TableHeading-{{ section.id }}" tabindex="0"><table>
{% if section.settings.header_1 != blank %}<thead><tr>{% for i in (1..columns) %}{% assign field = 'header_' | append: i %}<th scope="col">{{ section.settings[field] | escape }}</th>{% endfor %}</tr></thead>{% endif %}
<tbody>{% for block in section.blocks %}{% if block.settings.cell_1 != blank %}<tr {{ block.shopify_attributes }}>{% for i in (1..columns) %}{% assign field = 'cell_' | append: i %}{% if i == 1 %}<th scope="row">{{ block.settings[field] | escape | newline_to_br }}</th>{% else %}<td>{{ block.settings[field] | escape | newline_to_br }}</td>{% endif %}{% endfor %}</tr>{% endif %}{% endfor %}</tbody>
</table></div></section>{% endif %}
{% schema %}
{
  "name": "Bpm Editable data table",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "default": "2",
      "options": [
        {
          "value": "2",
          "label": "Two"
        },
        {
          "value": "5",
          "label": "Five"
        }
      ]
    },
    {
      "type": "text",
      "id": "header_1",
      "label": "Column 1 heading"
    },
    {
      "type": "text",
      "id": "header_2",
      "label": "Column 2 heading"
    },
    {
      "type": "text",
      "id": "header_3",
      "label": "Column 3 heading"
    },
    {
      "type": "text",
      "id": "header_4",
      "label": "Column 4 heading"
    },
    {
      "type": "text",
      "id": "header_5",
      "label": "Column 5 heading"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Table row",
      "settings": [
        {
          "type": "textarea",
          "id": "cell_1",
          "label": "Column 1"
        },
        {
          "type": "textarea",
          "id": "cell_2",
          "label": "Column 2"
        },
        {
          "type": "textarea",
          "id": "cell_3",
          "label": "Column 3"
        },
        {
          "type": "textarea",
          "id": "cell_4",
          "label": "Column 4"
        },
        {
          "type": "textarea",
          "id": "cell_5",
          "label": "Column 5"
        }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    {
      "name": "Bpm Editable data table"
    }
  ]
}
{% endschema %}
